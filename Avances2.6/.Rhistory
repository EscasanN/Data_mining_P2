knitr::opts_chunk$set(echo = TRUE)
datos <-read.csv("test.csv")
price <- read.csv("sample_submission.csv")
# Calculate the min, max, and ranges
max_price <- max(price$SalePrice)
min_price <- min(price$SalePrice)
rangos_a_partir <- (max_price - min_price) / 3
round_rangos <- round(rangos_a_partir)
# Define the price categories
bajo <- min_price + round_rangos
medio <- bajo + round_rangos
alto <- medio + round_rangos
# Step 1: Initialize 'economico' to 0 for all rows
price$economico <- 0
price$medio <- 0
price$caro <- 0
# Step 2: Create the 'medio' and 'caro' binary variables
price$medio <- ifelse(price$SalePrice > bajo & price$SalePrice <= medio, 1, 0)  # Medium (medio)
price$caro <- ifelse(price$SalePrice > medio, 1, 0)          # Expensive (caro)
# Step 3: Now set 'economico' to 1 for prices <= 'bajo'
price$economico <- ifelse(price$SalePrice <= bajo, 1, price$economico)
head(price)
train <- read.csv("train.csv")
# Calculate the min, max, and ranges
max_price <- max(train$SalePrice)
min_price <- min(train$SalePrice)
rangos_a_partir <- (max_price - min_price) / 3
round_rangos <- round(rangos_a_partir)
# Define the price categories
bajo <- min_price + round_rangos
medio <- bajo + round_rangos
alto <- medio + round_rangos
# Step 1: Initialize 'economico' to 0 for all rows
train$economico <- 0
train$medio <- 0
train$caro <- 0
# Step 2: Create the 'medio' and 'caro' binary variables
train$medio <- ifelse(train$SalePrice > bajo & train$SalePrice <= medio, 1, 0)  # Medium (medio)
train$caro <- ifelse(train$SalePrice > medio, 1, 0)          # Expensive (caro)
# Step 3: Now set 'economico' to 1 for prices <= 'bajo'
train$economico <- ifelse(train$SalePrice <= bajo, 1, train$economico)
head(train)
View(train)
knitr::opts_chunk$set(echo = TRUE)
# install.packages("palmerpenguins")
library(palmerpenguins)
knitr::opts_chunk$set(echo = TRUE)
# install.packages("palmerpenguins")
library(palmerpenguins)
library(ggplot2)
library(caret)
library(e1071)
data <- penguins
head(data)
summary(data)
ggplot(data = data, aes(x=island, y=body_mass_g,fill=species)) +
geom_boxplot()+
xlab("Island")+
ylab("body mass")
varRpta <- prop.table(table(data$species))*100
varRpta
barplot(varRpta, col = c("red","blue","green"),main = "Pocentaje de cada una de las especies", ylab = "Porciento", xlab = "Especie")
data[is.na(data$bill_length_mm),"bill_length_mm"]<-median(data$bill_length_mm,na.rm = T)
data[is.na(data$bill_depth_mm),"bill_depth_mm"]<-median(data$bill_depth_mm,na.rm = T)
data[is.na(data$body_mass_g),"body_mass_g"]<-median(data$body_mass_g,na.rm = T)
data[is.na(data$flipper_length_mm),"flipper_length_mm"]<-median(data$flipper_length_mm,na.rm = T)
data[is.na(data$sex),"sex"]<-"female"
set.seed(123)
porcentaje <-0.7
corte <- sample(nrow(data),nrow(data)*porcentaje)
train<-data[corte,]
test<-data[-corte,]
svm_model1<-svm(species~.,data = train, kernel="linear",scale = T)
pred_svm_model1<-predict(svm_model1,test[,-1])
confusionMatrix(test$species,pred_svm_model1)
control <- trainControl(method = "cv",number = 10)
c <- expand.grid(cost = c(0.01, 0.1, 1, 5,16,32))
svm_model2<- train(species~.,
data=train,
method="svmLinear2",
tuneGrid=c,
trControl=control,
metric="Accuracy"
)
pred_svm_model2<-predict(svm_model2,test[,-1])
confusionMatrix(test$species,pred_svm_model2)
params <- expand.grid(C = c(0.01, 0.1, 1, 5,16,32),sigma=c(0.0000000002,0.00002,0.01,0.1,20,200))
svm_model3<- train(species~.,
data=train,
method="svmRadial",
tuneGrid=params,
trControl=control,
metric="Accuracy"
)
pred_svm_model3<-predict(svm_model3,test[,-1])
confusionMatrix(test$species,pred_svm_model3)
params <- expand.grid(C = c(0.01, 0.1, 1, 5,16,32),degree=c(2,3,5,7),scale=c(0.01,0.1,1))
svm_model4<- train(species~.,
data=train,
method="svmPoly",
tuneGrid=params,
trControl=control,
metric="Accuracy"
)
pred_svm_model4<-predict(svm_model4,test[,-1])
confusionMatrix(test$species,pred_svm_model4)
knitr::opts_chunk$set(echo = TRUE)
# install.packages("palmerpenguins")
library(palmerpenguins)
library(ggplot2)
library(caret)
library(e1071)
data <- penguins
head(data)
summary(data)
ggplot(data = data, aes(x=island, y=body_mass_g,fill=species)) +
geom_boxplot()+
xlab("Island")+
ylab("body mass")
varRpta <- prop.table(table(data$species))*100
varRpta
barplot(varRpta, col = c("red","blue","green"),main = "Pocentaje de cada una de las especies", ylab = "Porciento", xlab = "Especie")
data[is.na(data$bill_length_mm),"bill_length_mm"]<-median(data$bill_length_mm,na.rm = T)
data[is.na(data$bill_depth_mm),"bill_depth_mm"]<-median(data$bill_depth_mm,na.rm = T)
data[is.na(data$body_mass_g),"body_mass_g"]<-median(data$body_mass_g,na.rm = T)
data[is.na(data$flipper_length_mm),"flipper_length_mm"]<-median(data$flipper_length_mm,na.rm = T)
data[is.na(data$sex),"sex"]<-"female"
set.seed(123)
porcentaje <-0.7
corte <- sample(nrow(data),nrow(data)*porcentaje)
train<-data[corte,]
test<-data[-corte,]
svm_model1<-svm(species~.,data = train, kernel="linear",scale = T)
pred_svm_model1<-predict(svm_model1,test[,-1])
confusionMatrix(test$species,pred_svm_model1)
control <- trainControl(method = "cv",number = 10)
c <- expand.grid(cost = c(0.01, 0.1, 1, 5,16,32))
svm_model2<- train(species~.,
data=train,
method="svmLinear2",
tuneGrid=c,
trControl=control,
metric="Accuracy"
)
pred_svm_model2<-predict(svm_model2,test[,-1])
confusionMatrix(test$species,pred_svm_model2)
params <- expand.grid(C = c(0.01, 0.1, 1, 5,16,32),sigma=c(0.0000000002,0.00002,0.01,0.1,20,200))
svm_model3<- train(species~.,
data=train,
method="svmRadial",
tuneGrid=params,
trControl=control,
metric="Accuracy"
)
pred_svm_model3<-predict(svm_model3,test[,-1])
confusionMatrix(test$species,pred_svm_model3)
params <- expand.grid(C = c(0.01, 0.1, 1, 5,16,32),degree=c(2,3,5,7),scale=c(0.01,0.1,1))
svm_model4<- train(species~.,
data=train,
method="svmPoly",
tuneGrid=params,
trControl=control,
metric="Accuracy"
)
pred_svm_model4<-predict(svm_model4,test[,-1])
confusionMatrix(test$species,pred_svm_model4)
View(data)
summary(data)
