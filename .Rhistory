porcentaje<-0.7
datos<-iris
set.seed(123)
datos$y<- as.numeric(datos$Species)
corte <- sample(nrow(datos),nrow(datos)*porcentaje)
train<-datos[corte,]
test<-datos[-corte,]
head(train)
head(test)
fitLMPW<-lm(Petal.Length~Petal.Width, data = train)
summary(fitLMPW)
library(ggplot2)
ggplot(data = train, mapping = aes(x = Petal.Width, y = Petal.Length)) +
geom_point(color = "firebrick", size = 2) +
geom_smooth(method = "lm", se = TRUE, color = "black") +
labs(title = "Longitud del Pétalo ~ Ancho del Pétalo", x = "Ancho", y = "Longitud") +
theme_bw() + theme(plot.title = element_text(hjust = 0.5))
