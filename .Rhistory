knitr::opts_chunk$set(echo = TRUE)
porcentaje<-0.7
datos<-iris
set.seed(123)
datos$y<- as.numeric(datos$Species)
corte <- sample(nrow(datos),nrow(datos)*porcentaje)
train<-datos[corte,]
test<-datos[-corte,]
head(train)
head(test)
fitLMPW<-lm(Petal.Length~Petal.Width, data = train)
summary(fitLMPW)
library(ggplot2)
ggplot(data = train, mapping = aes(x = Petal.Width, y = Petal.Length)) +
geom_point(color = "firebrick", size = 2) +
geom_smooth(method = "lm", se = TRUE, color = "black") +
labs(title = "Longitud del Pétalo ~ Ancho del Pétalo", x = "Ancho", y = "Longitud") +
theme_bw() + theme(plot.title = element_text(hjust = 0.5))
summary(fitLMPW)
predL<-predict(fitLMPW, newdata = test)
head(predL)
length(predL)
head(fitLMPW$residuals)
plot(fitLMPW)
hist(fitLMPW$residuals)
boxplot(fitLMPW$residuals)
qqnorm(fitLMPW$residuals)
qqline(fitLMPW$residuals, col="red")
library(nortest)
predLM<-predict(fitLMPW, newdata = test[,c(1,2,4)])
library(caret)
knitr::opts_chunk$set(echo = TRUE)
porcentaje<-0.7
datos<-iris
set.seed(123)
datos$y<- as.numeric(datos$Species)
corte <- sample(nrow(datos),nrow(datos)*porcentaje)
train<-datos[corte,]
test<-datos[-corte,]
head(train)
head(test)
fitLMPW<-lm(Petal.Length~Petal.Width, data = train)
summary(fitLMPW)
library(ggplot2)
ggplot(data = train, mapping = aes(x = Petal.Width, y = Petal.Length)) +
geom_point(color = "firebrick", size = 2) +
geom_smooth(method = "lm", se = TRUE, color = "black") +
labs(title = "Longitud del Pétalo ~ Ancho del Pétalo", x = "Ancho", y = "Longitud") +
theme_bw() + theme(plot.title = element_text(hjust = 0.5))
summary(fitLMPW)
predL<-predict(fitLMPW, newdata = test)
head(predL)
length(predL)
head(fitLMPW$residuals)
plot(fitLMPW)
hist(fitLMPW$residuals)
boxplot(fitLMPW$residuals)
qqnorm(fitLMPW$residuals)
qqline(fitLMPW$residuals, col="red")
library(nortest)
lillie.test(fitLMPW$residuals)
predLM<-predict(fitLMPW, newdata = test[,c(1,2,4)])
library(caret)
RMSE(predLM,test$Petal.Length)
plot(test$Petal.Length,col="blue")
points(predLM, col="red")
summary(test$Petal.Length-predLM)
fitMLM_Petal<-lm(Petal.Length~.,data = datos[,1:4])
summary(fitMLM_Petal)
plot(datos[,1:4])
# install.packages("corrplot")
library(corrplot)
matriz_cor <- cor(datos[,1:4])
matriz_cor
corrplot(matriz_cor)
fitMLM_Petal<-lm(Petal.Length~.,data = train[,2:4])
summary(fitMLM_Petal)
plot(fitMLM_Petal)
hist(fitMLM_Petal$residuals)
boxplot(fitMLM_Petal$residuals)
lillie.test(fitMLM_Petal$residuals)
predMLM<-predict(fitMLM_Petal,newdata = test[,c(1,2,4)])
RMSE(predMLM,test$Petal.Length)
plot(test$Petal.Length,col="blue")
points(predMLM, col="red")
summary(test$Petal.Length-predMLM)
